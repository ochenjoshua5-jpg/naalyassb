# Copy to .env.local for local work. Never commit real values (.env* is git-ignored).
#
# The public preview runs with the enquiry form OFF. Keep ENQUIRY_STORE=disabled until the
# school has approved the form, privacy text, storage, retention and staff access in writing.
ENQUIRY_STORE=disabled

# Set to "yes" only after written school approval. Required together with all settings below.
ENQUIRY_SCHOOL_APPROVED=

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public by design (Cloudflare Turnstile site key). Read at request time by the enquiry page.
TURNSTILE_SITE_KEY=

# Error monitoring (Sentry). Leave empty until the school creates a Sentry project. Empty = monitoring off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
